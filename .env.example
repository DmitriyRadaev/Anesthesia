# Пример конфигурации. Скопируйте в .env и задайте собственные значения.
# Файл .env не коммитится (см. .gitignore). Реальные пароли и ключи в репозиторий не добавляются.

# --- Django ---------------------------------------------------------------------------------
DJANGO_DEBUG=0
# Сгенерируйте: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8080
# Для локальной разработки по HTTP установите 0 (в production за HTTPS — 1).
DJANGO_SECURE_COOKIES=0
# Для production за HTTPS: DJANGO_SSL_REDIRECT=1, DJANGO_HSTS_SECONDS=31536000
DJANGO_SSL_REDIRECT=0
DJANGO_HSTS_SECONDS=0
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8080
TIME_ZONE=Europe/Samara
LOG_LEVEL=INFO

# --- PostgreSQL ------------------------------------------------------------------------------
POSTGRES_DB=anesthesia
POSTGRES_USER=anesthesia
POSTGRES_PASSWORD=change-me-db-password
# Для запуска backend вне Docker:
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# --- Авторизация -----------------------------------------------------------------------------
# Срок жизни токена доступа, часов (0 — без ограничения).
AUTH_TOKEN_TTL_HOURS=12
LOGIN_THROTTLE_RATE=10/min
# Первый администратор создаётся при старте контейнера, только если задан пароль.
# После первого входа удалите DJANGO_ADMIN_PASSWORD из .env.
DJANGO_ADMIN_USERNAME=admin
DJANGO_ADMIN_PASSWORD=

# --- Интеграции ------------------------------------------------------------------------------
# Ключ для СППВР (GET /api/cdss/result/{id}/) и HTTP-приёма HL7 (POST /api/monitoring/hl7/), заголовок X-API-Key.
# Пусто — доступ только по токену пользователя.
INTEGRATION_API_KEY=
CDSS_THROTTLE_RATE=60/min
# TCP-приёмник HL7 (manage.py hl7_listener / сервис hl7 в docker compose).
HL7_LISTEN_HOST=0.0.0.0
HL7_LISTEN_PORT=6112

# --- Публикуемые порты docker compose ---------------------------------------------------------
FRONTEND_PUBLISHED_PORT=8080
BACKEND_PUBLISHED_PORT=8000
POSTGRES_PUBLISHED_PORT=5432
HL7_PUBLISHED_PORT=6112
